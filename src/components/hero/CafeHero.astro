---
import { site, type Locale } from "../../data/site";
import { useTranslations } from "../../i18n/utils";
import { buildDirectionsUrl } from "../../lib/directions";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const tagline = site.tagline[lang] ?? site.tagline.en;
const directions = buildDirectionsUrl();
---

<section
  class="relative isolate overflow-hidden sm:flex sm:min-h-[82vh] sm:items-center"
>
  <!-- Mobile: image sits in flow with the copy beneath it (no overlay, so the
       cup stays fully visible and the text is crisp). Desktop (sm+): full-bleed
       image behind the copy. -->
  <picture>
    <source media="(max-width: 639px)" srcset={site.heroImageMobile} />
    <img
      src={site.heroImage}
      alt={t("hero.imageAlt")}
      width="2400"
      height="1400"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="block h-[52vh] w-full object-cover object-center sm:absolute sm:inset-0 sm:-z-20 sm:h-full"
    />
  </picture>

  <!-- Desktop legibility scrim, confined to the copy area so the photo stays vivid. -->
  <div
    class="absolute inset-0 -z-10 hidden bg-gradient-to-r from-bg from-0% via-bg/55 via-30% to-transparent to-56% sm:block"
    aria-hidden="true"
  >
  </div>

  <div class="container-page py-8 sm:py-16">
    <span class="eyebrow">{t("hero.eyebrow")}</span>
    <h1 class="mt-4 max-w-3xl font-heading text-5xl leading-[1.0] sm:text-7xl">
      {site.name}
    </h1>
    <p class="mt-4 max-w-lg text-lg text-text-muted sm:text-xl">{tagline}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#menu" class="btn btn-primary">{t("hero.cta")}</a>
      <a
        href={directions}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-outline"
      >
        {t("hero.directions")}
      </a>
    </div>
    <p class="mt-6 text-sm text-text-muted">
      {site.address[lang] ?? site.address.en}
    </p>
  </div>
</section>
