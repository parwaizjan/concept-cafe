---
import type { Locale } from "../../data/site";
import type { MenuItem as MenuEntry } from "../../lib/menu";
import { formatPrice } from "../../lib/format";
import { useTranslations } from "../../i18n/utils";
import MediaImage from "../MediaImage.astro";

interface Props {
  items: MenuEntry[];
  lang: Locale;
}

const { items, lang } = Astro.props;
const t = useTranslations(lang);
const specials = items.filter((item) => item.special);

const arrowClass =
  "inline-flex h-9 w-9 items-center justify-center rounded-full border border-border text-text-muted transition-colors hover:border-primary hover:text-primary disabled:opacity-40 disabled:hover:border-border disabled:hover:text-text-muted";
---

{
  specials.length > 0 && (
    <section class="border-y border-border bg-surface py-10" data-specials>
      <div class="container-page">
        <div class="mb-4 flex items-end justify-between gap-4">
          <div>
            <h2 class="font-heading text-2xl">{t("specials.title")}</h2>
            <p class="mt-1 text-sm text-text-muted">{t("specials.subtitle")}</p>
          </div>
          <div class="hidden shrink-0 items-center gap-2 md:flex">
            <button
              type="button"
              data-specials-prev
              class={arrowClass}
              aria-label={t("specials.title")}
            >
              <svg
                viewBox="0 0 24 24"
                class="h-4 w-4"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M15 18l-6-6 6-6" />
              </svg>
            </button>
            <button
              type="button"
              data-specials-next
              class={arrowClass}
              aria-label={t("specials.title")}
            >
              <svg
                viewBox="0 0 24 24"
                class="h-4 w-4"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M9 6l6 6-6 6" />
              </svg>
            </button>
          </div>
        </div>

        <ul
          data-specials-track
          class="no-scrollbar flex gap-4 overflow-x-auto pb-2"
        >
          {specials.map((item) => (
            <li class="w-64 shrink-0" data-special-card data-id={item.id}>
              <a href="#specials" class="card block h-full overflow-hidden">
                <MediaImage
                  image={item.image}
                  alt={item.name}
                  sizes="16rem"
                  class="aspect-[4/3] w-full object-cover"
                />
                <div class="p-3">
                  <div class="flex items-baseline justify-between gap-2">
                    <p class="truncate font-medium">{item.name}</p>
                    <span
                      data-price-display
                      class="shrink-0 font-semibold tabular-nums"
                    >
                      {formatPrice(item.price)}
                    </span>
                  </div>
                  {item.description && (
                    <p class="mt-1 line-clamp-2 text-sm text-text-muted">
                      {item.description}
                    </p>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<script>
  document.querySelectorAll<HTMLElement>("[data-specials]").forEach((root) => {
    const track = root.querySelector<HTMLElement>("[data-specials-track]");
    const prev = root.querySelector<HTMLButtonElement>("[data-specials-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-specials-next]");
    if (!track) return;

    const step = () => Math.max(240, track.clientWidth * 0.8);
    const update = () => {
      const max = track.scrollWidth - track.clientWidth - 1;
      if (prev) prev.disabled = track.scrollLeft <= 0;
      if (next) next.disabled = track.scrollLeft >= max;
    };

    prev?.addEventListener("click", () =>
      track.scrollBy({ left: -step(), behavior: "smooth" }),
    );
    next?.addEventListener("click", () =>
      track.scrollBy({ left: step(), behavior: "smooth" }),
    );
    track.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
  });
</script>
