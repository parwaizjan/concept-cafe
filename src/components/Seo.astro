---
import { site, type Locale } from "../data/site";
import { localizePath } from "../i18n/utils";

interface Props {
  title: string;
  description: string;
  lang: Locale;
  /** Logical (locale-less) path; always "/" for this single-page site. */
  path: string;
}

const { title, description, lang, path } = Astro.props;
const hrefFor = (locale: Locale) =>
  new URL(localizePath(path, locale), site.siteUrl).href;
const canonical = hrefFor(lang);
const ogImage = new URL(site.ogImage, site.siteUrl).href;

const dayNames = [
  "Sunday",
  "Monday",
  "Tuesday",
  "Wednesday",
  "Thursday",
  "Friday",
  "Saturday",
];

const sameAs = Object.values(site.socials).filter((url) => url);
const streetAddress = site.address.en.split(",")[0]?.trim() ?? site.address.en;

const jsonLd =
  path === "/"
    ? {
        "@context": "https://schema.org",
        "@type": "CafeOrCoffeeShop",
        name: site.name,
        description,
        url: site.siteUrl,
        image: ogImage,
        telephone: site.phone,
        servesCuisine: [...site.servesCuisine],
        priceRange: site.priceRange,
        hasMenu: new URL(`${localizePath("/", lang)}#menu`, site.siteUrl).href,
        address: {
          "@type": "PostalAddress",
          streetAddress,
          addressLocality: site.locality,
          addressCountry: "LK",
        },
        geo: {
          "@type": "GeoCoordinates",
          latitude: site.geo.lat,
          longitude: site.geo.lng,
        },
        openingHoursSpecification: site.hours
          .filter((hour) => hour.open)
          .map((hour) => ({
            "@type": "OpeningHoursSpecification",
            dayOfWeek: `https://schema.org/${dayNames[hour.day]}`,
            opens: hour.open,
            closes: hour.close,
          })),
        ...(sameAs.length > 0 ? { sameAs } : {}),
      }
    : null;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{!site.indexable && <meta name="robots" content="noindex, nofollow" />}

{
  site.locales.map((locale) => (
    <link rel="alternate" hreflang={locale} href={hrefFor(locale)} />
  ))
}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={lang} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />

{
  jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )
}
