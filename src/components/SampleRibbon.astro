---
import { site, type Locale } from "../data/site";
import { buildWhatsAppUrl } from "../lib/whatsapp";
import { buildWebsiteEnquiry } from "../lib/contact";
import { useTranslations } from "../i18n/utils";
import WhatsAppIcon from "./icons/WhatsAppIcon.astro";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// The ribbon's WhatsApp link is an owner website enquiry — untagged, unlike the
// visitor CTAs, which are prefixed with the demo tag in `lib/contact.ts`.
const href = buildWhatsAppUrl(buildWebsiteEnquiry(t));
---

{
  site.showDemoRibbon && (
    <div class="demo-ribbon">
      <div class="container-page">
        {t("ribbon.text")}
        {" · "}
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1"
        >
          <WhatsAppIcon size={13} />
          {t("common.messageUs")}
        </a>
      </div>
    </div>
  )
}
